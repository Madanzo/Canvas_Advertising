rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'camiloreyna@canvas-advertising.com',
          'camilo@canvas-advertising.com',
          'sales@canvas-advertising.com'
        ];
    }

    function isAllowedLeadType() {
      return request.resource.contentType in [
        'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif',
        'application/pdf', 'application/postscript', 'application/illustrator',
        'application/vnd.adobe.illustrator', 'application/octet-stream'
      ];
    }

    match /lead-uploads/{submissionId}/{fileId}/{fileName} {
      allow create: if submissionId.matches('[A-Za-z0-9_-]{16,80}')
        && fileId.matches('[a-f0-9]{24}')
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && isAllowedLeadType()
        && request.resource.metadata.submissionId == submissionId
        && request.resource.metadata.fileId == fileId
        && request.resource.metadata.uploadToken is string
        && request.resource.metadata.originalName is string
        && (fileId + '/' + fileName) in firestore.get(/databases/(default)/documents/leadUploadSessions/$(submissionId)).data.allowedPaths
        && firestore.get(/databases/(default)/documents/leadUploadSessions/$(submissionId)).data.consumed == false
        && firestore.get(/databases/(default)/documents/leadUploadSessions/$(submissionId)).data.expiresAt > request.time
        && firestore.get(/databases/(default)/documents/leadUploadSessions/$(submissionId)).data.token == request.resource.metadata.uploadToken;
      // Public callers may only create a server-authorized upload. Verified
      // staff can inspect or remove it; mutations require a fresh session.
      allow read, delete: if isStaff();
      allow update: if false;
    }

    // The admin dashboard stores portfolio media under this explicit prefix.
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Everything without an explicit rule is denied. Cloud Functions use the
    // Admin SDK and therefore retain verification and cleanup access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
