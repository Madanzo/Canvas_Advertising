# Deploy-time parameters for the CRM forwarding functions, project canvas-adnvertising.
#
# Non-secret only. MERKAD_LEADS_CREDENTIAL is deliberately absent: it lives in
# Secret Manager (version 1) and is bound by reference through
# functions.runWith({ secrets: [...] }) on syncLeadToCRM and
# processCrmLeadDeliveryQueue. Its value is never read into this repository.
#
# Firebase reads .env.<project> automatically for --project canvas-adnvertising,
# and both functions read their own environment, so these four apply to both.
#
# Each value below was verified against live state before being set:
#   MERKAD_LEADS_TENANT_SLUG   tenants/canvas_advertising, slug canvas_advertising,
#                              owner vsLEY55ofGe8cg4S0wmMB3VvbeR2 (active admin),
#                              stage new_lead, notificationOwner "website"
#   MERKAD_LEADS_BASE_URL      GET on the intake route returns 405 (deployed, POST-only)
#   SERVICE_ALLOWLIST          the adapter's 10 mapping targets match the tenant's
#                              10 stored service labels exactly, both directions
#   CREDENTIAL                 api key oUPILzf3FyjiqmWa active, scope leads:write;
#                              Secret Manager version 1 ENABLED and bound
#
# Turning forwarding off is a one-line change here plus a redeploy of the two
# functions. It needs no code change.

CRM_LEAD_ADAPTER_ENABLED=true
MERKAD_LEADS_BASE_URL=https://crm.merkadagency.com
MERKAD_LEADS_TENANT_SLUG=canvas_advertising
MERKAD_LEADS_SERVICE_ALLOWLIST_CONFIRMED=true
