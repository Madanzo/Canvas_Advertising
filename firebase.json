{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "serviceAccountKey.json", "*.py", "*.md", "*.log", ".env*",
      "check_logs.js", "scratch/**", "checkpoints/**", "firestore.rules",
      "package.json", "package-lock.json", "docs/**", "tests/**", "scripts/**"
    ],
    "rewrites": [
      { "source": "/api/commerce", "function": "canvasCommerce" },
      {
        "source": "/projects/**",
        "function": "serveProjectPage"
      },
      {
        "source": "/es/proyectos/**",
        "function": "serveProjectPage"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
