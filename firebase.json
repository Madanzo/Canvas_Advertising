{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/projects/**",
        "function": "serveProjectPage"
      },
      {
        "source": "/es/proyectos/**",
        "function": "serveProjectPage"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node \"$PROJECT_DIR/tools/check-workflow-deployment.cjs\" \"$RESOURCE_DIR\""
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
